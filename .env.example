# Required for TLD-List pricing and metadata tools
TLD_LIST_PUBLIC_KEY=your_public_key
TLD_LIST_PRIVATE_KEY=your_private_key

# Optional reliability and cache settings
TLD_LIST_API_BASE_URL=https://api.tld-list.com/v1
TLD_LIST_REQUEST_TIMEOUT_MS=15000
TLD_LIST_MAX_RETRIES=2
TLD_LIST_CACHE_ENABLED=true
TLD_LIST_TLDS_CACHE_TTL_MS=86400000
TLD_LIST_REGISTRARS_CACHE_TTL_MS=86400000
TLD_LIST_PRICING_CACHE_TTL_MS=900000

# RDAP is enabled by default and does not use TLD-List credentials.
RDAP_ENABLED=true
RDAP_REQUEST_TIMEOUT_MS=10000
RDAP_MAX_CONCURRENCY=5
RDAP_BOOTSTRAP_CACHE_TTL_MS=86400000

# Diagnostic messages go to stderr only. Credentials are always redacted.
TLD_LIST_MCP_DEBUG=false
